          <mxGeometry x="-0.2968" y="-10" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="noteResilience" value="&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;b&gt;Паттерны отказоустойчивости (OSAGO):&lt;br&gt;&lt;/b&gt;• &lt;b&gt;core-app&lt;/b&gt;:&amp;nbsp;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Rate Limiting (до 2500 concurrent),&amp;nbsp;&lt;/li&gt;&lt;li&gt;Timeout на REST/SSE (SSE может переподключаться)&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;• &lt;b&gt;osago-aggregator&lt;/b&gt; → страховые:&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Timeout ≤ 60s,&amp;nbsp;&lt;/li&gt;&lt;li&gt;Retry+backoff,&amp;nbsp;&lt;/li&gt;&lt;li&gt;Circuit Breaker,&amp;nbsp;&lt;/li&gt;&lt;li&gt;Rate Limiting (per-insurer и общий)&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;• обработка событий: идемпотентность (возможны повторы)&lt;/div&gt;&lt;/blockquote&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;" parent="1" vertex="1">
          <mxGeometry x="-1140" y="-1450" width="710" height="220" as="geometry" />
        </mxCell>
        <mxCell id="noteSSE" value="&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;OSAGO UI: REST для старта + SSE для стрима офферов по мере поступления (каждая страховая — отдельное событие).&lt;br&gt;При нескольких репликах core-app: sticky sessions на ingress ИЛИ хранить офферы/статусы в общем хранилище по quoteRequestId.&lt;/blockquote&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;" parent="1" vertex="1">
          <mxGeometry x="-1150" y="-1540" width="710" height="80" as="geometry" />
        </mxCell>
